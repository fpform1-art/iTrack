# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- The Odds API (optional for beta) ---
# https://the-odds-api.com — without this, listed-game lookup is disabled and
# users can still track everything via Manual Entry.
ODDS_API_KEY=

# --- Beta access gate (optional) ---
# If set, signup requires this code. Leave empty to allow open signup.
BETA_ACCESS_CODE=

# --- App URL (used for auth redirect links, e.g. password reset / magic link) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: this app does NOT use a Supabase service-role key anywhere. All
# server-side writes (including the Odds API fixture cache) go through
# either RLS-scoped queries as the signed-in user or a narrowly-scoped
# SECURITY DEFINER Postgres function — see
# supabase/migrations/0005_fixture_cache_rpc.sql. There is deliberately no
# broadly-privileged secret to configure or leak.
